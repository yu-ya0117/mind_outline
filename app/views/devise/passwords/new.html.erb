<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-md">
    <h2 class="mb-6 text-center text-2xl font-bold text-gray-800">パスワード再設定</h2>
    <p class="mb-4 text-gray-600">登録済みのメールアドレスを入力してください。<br>
  パスワード再設定用のリンクを送信します。</p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <p class="mb-2 text-sm font-semibold text-gray-700">
          <%= f.label :email, "メールアドレス" %>
        </p>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
      </div>

      <div class="mt-6 text-center">
        <%= f.submit "再設定メールを送信", class: "w-full inline-block rounded-lg bg-green-600 px-6 py-3 text-white font-semibold hover:bg-green-700 sm:w-auto" %>
      </div>

      <div class="mt-6 text-center">
        <%= link_to "ログイン画面へ戻る", new_user_session_path,
            class: "w-full inline-block rounded-lg bg-gray-200 px-6 py-3 text-center text-gray-800 font-semibold hover:bg-gray-300 sm:w-auto" %>
      </div>
    <% end %>
  </div>
</div>
