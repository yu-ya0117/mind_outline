<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-8">
  <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-md">
    <h2 class="mb-6 text-center text-2xl font-bold text-gray-800">新しいパスワードの設定</h2>

    <p class="mb-6 text-sm leading-6 text-gray-600">
      新しいパスワードを入力してください。<br>
      確認のため、同じパスワードをもう一度入力します。
    </p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="mb-4">
        <p class="mb-2 text-sm font-semibold text-gray-700">
          <%= f.label :password, "新しいパスワード" %>
        </p>
        <%= f.password_field :password,
            autofocus: true,
            autocomplete: "new-password",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
      </div>

      <div class="mb-6">
        <p class="mb-2 text-sm font-semibold text-gray-700">
          <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
        </p>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:flex sm:justify-center">
        <%= f.submit "パスワードを更新",
            class: "w-full rounded-lg bg-green-600 px-6 py-3 font-semibold text-white hover:bg-green-700 sm:w-auto" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= link_to "ログイン画面へ戻る",
          new_user_session_path,
          class: "text-sm font-semibold text-green-600 hover:text-green-700 hover:underline" %>
    </div>
  </div>
</div>
